[Unit]
Description=Start opted-in workshop VMs on owner messages
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/opt/zab-waker/bin/waker run --config /etc/zab-waker/config.toml
Restart=always
RestartSec=5
StateDirectory=zab-waker
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target

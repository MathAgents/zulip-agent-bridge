# docs/ADMIN.md §1.2. One process hosts every admin bot of admin.toml, each workshop's and the
# global one, so that they share state.db, the apply lock and the audit log's hash chain.
[Unit]
Description=zab admin bots: plans, approvals and applies for every workshop
Wants=network-online.target zab-admin-imds.service zab-archive-check.socket
After=network-online.target zab-admin-imds.service zab-archive-check.socket

[Service]
User=zab-admin
Group=zab-admin
ExecStart=/opt/zab-admin/current/.venv/bin/python -I -m zab.admin bot --config /etc/zab-admin/admin.toml
# Rosters, out/, state.db, audit.jsonl, runs/, console/ and waker/ (§1.3); not its own SSH key;
# !new-workshop's request to the config helper (§2.9), in that helper's requests/ (root's parent);
# and !upgrade-server's requests to the upgrade helpers (§1.6, #569), in theirs.
ReadWritePaths=/var/lib/zab-admin -/var/lib/zab-admin-config/requests -/var/lib/zab-admin-upgrade/requests
ReadOnlyPaths=/var/lib/zab-admin/.ssh
Restart=always
RestartSec=5
# SIGTERM to the bot alone: the runner stops each running script's process group itself and
# records the apply as interrupted (ADMIN §2.4 step 6). Whatever is left of the unit still gets
# SIGKILL once the bot has exited, or after TimeoutStopSec, which leaves the runner's stop (5 s
# for SIGTERM, 5 s to drain, then apply_end) a wide margin.
KillMode=mixed
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target

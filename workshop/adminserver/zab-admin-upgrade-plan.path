# docs/ADMIN.md §1.6 (#569): start the upgrade's plan helper when !upgrade-server's dry run has
# written its request (renamed into place by zab-admin). The helper deletes the request once read.
[Unit]
Description=zab admin upgrade helper: watch for an !upgrade-server plan's request

[Path]
PathExists=/var/lib/zab-admin-upgrade/requests/plan.json
Unit=zab-admin-upgrade-plan.service

[Install]
WantedBy=paths.target
